{
  "name": "vashgruz-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://websitepreview26.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "vashgruz-orders",
    "database_id": "REPLACE_WITH_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": false }
}
